# fastlane match — signing identities live in an encrypted private git repo, so a
# new Mac can obtain them with `bundle exec fastlane match appstore --readonly`
# instead of the situation on 2026-08-05, where no distribution private key
# existed on this machine and the upload was blocked.
#
# The repo contents are encrypted with MATCH_PASSWORD. That passphrase is NOT
# stored here or in the repo — keep it in a password manager.

git_url("https://github.com/Henzolena/ios-certificates.git")
storage_mode("git")

type("appstore")
app_identifier(["com.gorobale.Scripture-Unlock"])
team_id("98DPKSGQ2P")

# Authenticate with the App Store Connect API key rather than an Apple ID, so
# this works unattended. Note: this key has App Manager access, which is enough
# for match but NOT for Xcode cloud signing.
api_key_path("/Users/henokrobale/.appstoreconnect/asc_api_key.json")
