// Secrets.xcconfig.example
// Copy to Secrets.xcconfig and fill in real values. Never commit the real file
// — .gitignore already covers *.xcconfig, with an exception for this example.
//
// In Xcode: Target -> Build Settings -> search "xcconfig", then point both the
// Debug and Release configurations at Secrets.xcconfig.
//
// IMPORTANT — do not put "//" in a value. xcconfig treats it as the start of a
// comment, so "https://host" silently becomes "https:". That is why these are
// bare hosts; the app rebuilds the scheme itself as "https://\(host)".
//
// Only three of these reach the app. Scripture-Unlock-Info.plist maps
// SUPABASE_HOST, SUPABASE_ANON_KEY and GEMINI_API_KEY into the bundle, and the
// services read them via Bundle.main.object(forInfoDictionaryKey:). Anything
// added here that is not also added to the plist is invisible at runtime.

// ---- Required ----------------------------------------------------------

// supabase.com -> project -> Settings -> API. Host only, no scheme.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6...

// aistudio.google.com -> Get API key. Used by QuestionGeneratorAgent.
// NOTE: this ships inside the app binary. Before release, proxy it through a
// Supabase Edge Function so the key never leaves the server.
GEMINI_API_KEY = your-gemini-api-key-here

// ---- Currently unused --------------------------------------------------
// Kept for reference only. Neither is in the plist, and no Swift code calls
// rest.api.bible — Bible text comes from the Railway API noted below instead.
// Drop these unless you are wiring API.Bible back up.
BIBLE_API_HOST = rest.api.bible
BIBLE_API_KEY = your-api-bible-key-here

// ---- Not an app secret -------------------------------------------------
// RESEND_API_KEY belongs to the accountability-email Edge Function and is set
// as a Supabase function secret, not here. Do not add it to the plist.

// ---- No key required ---------------------------------------------------
// Ethiopian Bible API — Amharic, Oromo, Tigrigna, English/NIV, plus the quiz,
// study-guide and verse-of-the-day endpoints. The host is hard-coded in
// EthiopianBibleService; listed here for orientation only:
//   ethiopian-bible-api-production.up.railway.app
