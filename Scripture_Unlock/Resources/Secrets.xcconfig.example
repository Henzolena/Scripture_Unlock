// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in real values.
// Add Secrets.xcconfig to .gitignore IMMEDIATELY — never commit real keys.
//
// In Xcode: Target → Build Settings → search "xcconfig"
// Set Debug and Release configurations to Secrets.xcconfig.
//
// Keys:
//   Supabase:  supabase.com → project → Settings → API
//   API.Bible: scripture.api.bible → sign up → create app → copy API key

SUPABASE_URL = https://your-project-ref.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6...
BIBLE_API_KEY = your-api-bible-key-here
BIBLE_API_ENDPOINT = https://rest.api.bible
